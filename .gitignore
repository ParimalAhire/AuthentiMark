# ───────────────────────── Dependencies ─────────────────────────
node_modules/
.pnp
.pnp.js

# ───────────────────────── Build output ─────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ─────────────── Trained model checkpoints (large) ──────────────
