models/
authentimark-gui/models/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.pkl

# ───────────────────────────── Python ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ─────────────────────── Environment / secrets ─────────────────
.env
.env.local
.env.*.local

# VITE_API_URL is the public backend URL, not a secret. Vite needs .env.production
# at build time (Render builds from the repo), so it is intentionally committed.
!.env.production
!.env.example

